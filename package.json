{
  "name": "handstrike",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HANDSTRIKE - Real-time webcam boxing. An arcade fighting game controlled entirely through computer vision.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-assets.mjs && tsc -b && vite build",
